### Login
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "wilson@teste.com",
  "password": "senha123"
}

> {%
    client.global.set("token", response.body.token);
%}

### Criar uma matéria (pré-requisito)
POST http://localhost:8080/subjects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Química",
  "description": "Orgânica e inorgânica"
}

> {%
    client.global.set("subjectId", response.body.id);
%}

### Criar um cronograma (pré-requisito)
POST http://localhost:8080/schedules
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Semana de Química",
  "startDate": "2026-09-08",
  "endDate": "2026-09-14"
}

> {%
    client.global.set("scheduleId", response.body.id);
%}

### Criar uma tarefa (pré-requisito)
POST http://localhost:8080/tasks
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "subjectId": {{subjectId}},
  "scheduleId": {{scheduleId}},
  "title": "Revisar tabela periódica",
  "dueDate": "2026-09-10"
}

> {%
    client.global.set("taskId", response.body.id);
%}

### Criar um registro de estudo
POST http://localhost:8080/study-logs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "taskId": {{taskId}},
  "subjectId": {{subjectId}},
  "logDate": "2026-09-09",
  "hoursStudied": 2.5
}

> {%
    client.global.set("studyLogId", response.body.id);
%}

### Listar registros de estudo de uma matéria específica
GET http://localhost:8080/study-logs?subjectId={{subjectId}}
Authorization: Bearer {{token}}

### Buscar um registro específico pelo id
GET http://localhost:8080/study-logs/{{studyLogId}}
Authorization: Bearer {{token}}

### Atualizar o registro de estudo
PUT http://localhost:8080/study-logs/{{studyLogId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "taskId": {{taskId}},
  "subjectId": {{subjectId}},
  "logDate": "2026-09-09",
  "hoursStudied": 3.0
}

### Deletar o registro de estudo
DELETE http://localhost:8080/study-logs/{{studyLogId}}
Authorization: Bearer {{token}}

### Criar registro sem token (deve dar 403)
POST http://localhost:8080/study-logs
Content-Type: application/json

{
  "taskId": {{taskId}},
  "subjectId": {{subjectId}},
  "logDate": "2026-09-09",
  "hoursStudied": 1.0
}

### Criar registro com hoursStudied zero (deve dar 400, @DecimalMin não aceita)
POST http://localhost:8080/study-logs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "taskId": {{taskId}},
  "subjectId": {{subjectId}},
  "logDate": "2026-09-09",
  "hoursStudied": 0
}

### Criar registro sem logDate (deve dar 400, validação do @NotNull)
POST http://localhost:8080/study-logs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "taskId": {{taskId}},
  "subjectId": {{subjectId}},
  "hoursStudied": 1.0
}
